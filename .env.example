# Jira Integration Configuration
# Copy this file to .env and fill in your values

# Jira Cloud URL (without trailing slash)
JIRA_URL=https://your-domain.atlassian.net

# Your Jira email
JIRA_EMAIL=your-email@example.com

# Jira API Token (get from https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your-api-token-here

# Jira Project Key (e.g., SCRUM, QA, DEV)
JIRA_PROJECT_KEY=SCRUM

# Optional: Auto-transition newly created stories to this status (default: "Ready for QA")
# Leave empty to keep stories in default status
JIRA_AUTO_STATUS=Ready for QA

# ============================================================================
# Confluence Integration Configuration (for Requirements Ingestion)
# ============================================================================

# For Confluence Cloud (*.atlassian.net):
# You can use the same credentials as Jira if they're on the same Atlassian instance
CONFLUENCE_EMAIL=your-email@example.com
CONFLUENCE_API_TOKEN=your-api-token-here

# Alternative: Use Atlassian-wide credentials (works for both Jira and Confluence)
ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_TOKEN=your-api-token-here

# For Confluence Server/Data Center (self-hosted):
# CONFLUENCE_BASE_URL=https://confluence.yourcompany.com
# CONFLUENCE_API_TOKEN=your_personal_access_token

# ============================================================================
# Optional: Google AI API (for LLM-powered features)
# ============================================================================
# GOOGLE_API_KEY=your_google_api_key_here
