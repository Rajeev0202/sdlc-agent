# Environment Variables for SDLC Agent
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# Atlassian Integration (Jira & Confluence)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_api_token_here
JIRA_PROJECT_KEY=SCRUM
JIRA_AUTO_STATUS=Ready for QA

# Confluence (uses same token as Jira)
CONFLUENCE_EMAIL=your-email@example.com
CONFLUENCE_API_TOKEN=your_api_token_here
ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_TOKEN=your_api_token_here

# LLM Backend (Optional)
ANTHROPIC_API_KEY=your_anthropic_key_here
GOOGLE_API_KEY=your_google_key_here

# Model Configuration (Optional - cost optimization)
# Default: Sonnet for code generation, Haiku for review
ANTHROPIC_MODEL=claude-3-5-sonnet-latest        # Stages 1, 2, 3
ANTHROPIC_REVIEW_MODEL=claude-3-5-haiku-latest  # Stage 4 (12x cheaper)

# LLM Response Cache (Optional - persistent cost savings)
# If REDIS_URL set: persistent cache (survives restarts) — recommended
# If not set: in-memory cache (lost on restart)
# REDIS_URL=redis://localhost:6379/0
# LLM_CACHE_TTL=86400  # 24h default

# GitHub Integration
GITHUB_TOKEN=your_github_token_here
GIT_AUTHOR_NAME=premkumarhcl
GIT_AUTHOR_EMAIL=premkumar.manokaran@hcltech.com
